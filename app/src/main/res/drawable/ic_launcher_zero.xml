<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Внешний круг с градиентом (кольцо) -->
    <path
        android:pathData="M54,10 A44,44 0 1,1 53.99,10 Z"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="10" android:startY="10"
                android:endX="98" android:endY="98"
                android:type="linear">
                <item android:offset="0" android:color="#7C3AED"/>
                <item android:offset="0.5" android:color="#EC4899"/>
                <item android:offset="1" android:color="#F59E0B"/>
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeWidth">
            <attr name="android:value" android:value="5.5" />
        </aapt:attr>
    </path>

    <!-- Внутренний круг — заливка с градиентом -->
    <path
        android:pathData="M54,17 A37,37 0 1,1 53.99,17 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="17" android:startY="17"
                android:endX="91" android:endY="91"
                android:type="linear">
                <item android:offset="0" android:color="#7C3AED"/>
                <item android:offset="0.5" android:color="#EC4899"/>
                <item android:offset="1" android:color="#F59E0B"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Буква Z белая -->
    <path
        android:pathData="M37,38 L71,38 L71,45 L49,68 L71,68 L71,75 L37,75 L37,68 L59,45 L37,45 Z"
        android:fillColor="#FFFFFF"/>

</vector>
